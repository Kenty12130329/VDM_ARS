@startuml
!theme plain
title System Architecture Diagram (Java_RandomSearch Modules and I/O)

skinparam componentStyle rectangle
skinparam linetype ortho
skinparam ranksep 70
skinparam nodesep 60
skinparam packagePadding 15
skinparam dpi 150

' External Inputs
package "Inputs" {
  [VDM Model (*.vdmpp)] as VdmFile
  [Transition Config (*.csv)] as CsvFile
  [Execution Parameters\n(MaxDepth, MaxRuns, StagnantThreshold)] as Args
}

' Random Search Engine
package "Random Search Engine" {
  [Main Controller\n(ArsMain.java)] as Main
  [Random Search Engine\n(ArsExplorer.java)] as Explorer
  [VDMJ Process Controller\n(ArsVDMController.java)] as Controller
  [Check Object Representation\n(CheckObject.java)] as CheckObj
  [Convergence Evaluator\n(ConvergenceChecker.java)] as Checker
  [String Utility\n(StringValue.java)] as StrUtil
}

' External Libraries
package "Libraries" {
  [VDMJ Interpreter\n(vdmj-4.6.0.jar)] as VDMJ
}

' External Outputs
package "Outputs" {
  [Statistics Summary\n(statistics_summary.txt)] as SummaryReport
  [Violation Trace\n(found_trace.txt)] as TraceReport
  [Transition Log\n(transition_log.csv)] as TransitionLog
  [Variable History\n(variable_history.csv)] as VarHistory
}

' Layout alignment helpers
VdmFile -[hidden]right-> CsvFile
CsvFile -[hidden]right-> Args

SummaryReport -[hidden]right-> TraceReport
TraceReport -[hidden]right-> TransitionLog
TransitionLog -[hidden]right-> VarHistory

' Inputs and Settings Flow
VdmFile -down-> Main : Specify VDM Model Path
Args -down-> Main : Read Exploration Parameters
CsvFile -down-> Explorer : Load Transition CSV (if present)

' Internal Module Interactions Flow
Main -down-> Explorer : Issue Exploration Instruction
Explorer -down-> Controller : Instantiate / Get State / \nExecute Operation
Controller -right-> VDMJ : Process Communication\n(stdin/stdout)
Controller -down-> StrUtil : Parse Variable String Values

' Convergence Check and Check Object Tracking Flow
Explorer -right-> CheckObj : Construct (Mw, w, Mr, r)\nCombination
Explorer -right-> Checker : Register CheckObject / \nEvaluate Convergence

' External Outputs Flow
Explorer -down-> SummaryReport : Output Statistics & Convergence Result
Explorer -down-> TraceReport : Output Invariant Violation Trace
Explorer -down-> TransitionLog : Output Execution Transition Log
Explorer -down-> VarHistory : Output Variable History Across Steps

@enduml
