class TestMapRecord

types
    public User ::
        id : int
        score : int;

instance variables
    -- IDからUserレコードへのマップ
    public user_db : map int to User := {
        1 |-> mk_User(1, 100),
        2 |-> mk_User(2, 200)
    };

    -- 不変条件: 全員のスコアは0以上であること
    inv forall id in set dom user_db & user_db(id).score >= 0;

operations
    -- [Safe] 特定のユーザーのスコアを更新する
    public UpdateScore: int * int ==> ()
    UpdateScore(targetId, newScore) == (
        dcl u : User;
        -- マップのキー存在確認
        if targetId in set dom user_db then (
            -- 1. 取得 (Read)
            u := user_db(targetId);
            
            -- 2. レコード更新 (Record Update)
            u.score := newScore;
            
            -- 3. マップ更新 (Map Update - 今回の主役！)
            user_db(targetId) := u;
        )
    );

    -- [Unsafe] スコアをマイナスにする（不変条件違反チェック）
    public BreakScore: int ==> ()
    BreakScore(targetId) == (
        dcl u : User;
        if targetId in set dom user_db then (
            u := user_db(targetId);
            u.score := -50;  -- 負の値を直接設定（不変条件違反！）
            user_db(targetId) := u;
        )
    );

end TestMapRecord