-- MiniLibrarySafe: Map + Record + Set の入れ子構造テスト（安全バージョン）
-- 目的: 不変条件に違反しない正常な操作フローの検証

class MiniLibrarySafe

types
    -- ユーザーレコード: 名前と借りている本のID集合
    public User ::
        name : seq of char
        borrowed : set of int;

instance variables
    -- 会員IDからUserレコードへのマップ
    public user_db : map int to User := {
        1 |-> mk_User("Alice", {100}),  -- Aliceは既に1冊所持
        2 |-> mk_User("Bob", {})         -- Bobは本を借りていない
    };

    -- 不変条件: 全ユーザーの借りている本は2冊以下
    inv forall id in set dom user_db & 
        card(user_db(id).borrowed) <= 2;

operations
    -- [Safe] 本を借りる操作
    -- userId: 会員ID, bookId: 本のID
    public Borrow: int * int ==> ()
    Borrow(userId, bookId) == (
        dcl u : User;
        -- マップにユーザーが存在する場合のみ処理
        if userId in set dom user_db then (
            -- 1. マップからUserレコードを取得
            u := user_db(userId);
            
            -- 2. borrowedセットに本を追加
            u.borrowed := u.borrowed union {bookId};
            
            -- 3. 更新したレコードをマップに書き戻す
            user_db(userId) := u;
        )
    )
    -- 事前条件: 借りる前に既に2冊借りていない
    pre userId in set dom user_db => 
        card(user_db(userId).borrowed) < 2;

    -- [Safe] 本を返す操作
    -- userId: 会員ID, bookId: 本のID  
    public Return: int * int ==> ()
    Return(userId, bookId) == (
        dcl u : User;
        if userId in set dom user_db then (
            u := user_db(userId);
            
            -- borrowedセットから本を削除
            u.borrowed := u.borrowed \ {bookId};
            
            user_db(userId) := u;
        )
    );

    -- [Safe] Aliceに1冊だけ追加（合計2冊で不変条件内）
    public SafeBorrow: () ==> ()
    SafeBorrow() == (
        dcl u : User;
        u := user_db(1);
        
        -- Aliceは既に100を持っているので、200を追加して2冊（不変条件内）
        u.borrowed := {100, 200};
        
        user_db(1) := u;
    );

end MiniLibrarySafe
