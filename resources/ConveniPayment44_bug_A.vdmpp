-- ================================================================
-- コンビニ収納代行システム bugA (Scan:DB参照 -> VerifyCheckDigitモデル)
-- ConveniPayment44_bug_A.vdmpp
-- ================================================================

class ConveniPayment44

types
    -- 請求データベースレコード
    public invoice ::
        company_code : nat
        customer_id : nat
        amount : nat;

    -- セッション情報 (stage: 0=NONE, 1=SCANNED, 2=VERIFIED, 3=PAID)
    public Session ::
        stage : nat
        comp_code : nat
        cust_id : nat
        amount : nat
        check_digit : nat
        paid_amount : nat;

instance variables
    -- 未払い請求データベース (10件)
    public pending_invoices : set of invoice := {
        mk_invoice(123456, 100001, 3000),   -- CD=8
        mk_invoice(123456, 100002, 5500),   -- CD=8
        mk_invoice(789012, 200001, 12000),  -- CD=3
        mk_invoice(123456, 100003, 7200),
        mk_invoice(123456, 100004, 1500),
        mk_invoice(789012, 200002, 8900),
        mk_invoice(789012, 200003, 45000),
        mk_invoice(345678, 300001, 9800),
        mk_invoice(345678, 300002, 2100),
        mk_invoice(345678, 300003, 64000)
    };
    
    -- 支払済み請求
    public paid_invoices : set of invoice := {};

    -- 現在のセッション
    public current_session : Session := mk_Session(0, 0, 0, 0, 0, 0);

    -- 不変条件: 同一IDが二重に存在しない
    inv forall p in set pending_invoices, q in set paid_invoices &
        not (p.company_code = q.company_code and p.customer_id = q.customer_id);

operations
    -- 1. バーコード読み取り (Scan)
    public Scan: nat * nat * nat * nat ==> ()
    Scan(comp_code, cust_id, amt, check_digit) == (
        current_session := mk_Session(1, comp_code, cust_id, amt, check_digit, 0);
    )
    pre 
        current_session.stage = 0
        and
        -- 未払いDBに存在する請求書であることを条件にスキャン
        mk_invoice(comp_code, cust_id, amt) in set pending_invoices;

    -- 2. チェックデジット検証 (VerifyCheckDigit)
    public VerifyCheckDigit: () ==> ()
    VerifyCheckDigit() == (
        current_session.stage := 2;
    )
    pre 
        current_session.stage = 1
        and
        -- モジュラス10 チェックデジット検証
        current_session.check_digit = CheckDigit(current_session.comp_code, current_session.cust_id, current_session.amount);

    -- 3. 支払い実行 (Pay)
    public Pay: nat ==> ()
    Pay(cash) == (
        current_session.stage := 3;
        current_session.paid_amount := cash;
    )
    pre current_session.stage = 2 and cash >= current_session.amount;

    -- 4. レシート発行・完了 (IssueReceipt)
    public IssueReceipt: () ==> ()
    IssueReceipt() == (
        dcl target_inv: invoice := mk_invoice(current_session.comp_code, current_session.cust_id, current_session.amount);
        
        -- バグ: DBから削除し忘れる (不変条件違反の原因)
        -- pending_invoices := pending_invoices \ {target_inv};
        paid_invoices := paid_invoices union {target_inv};
        
        -- セッションリセット
        current_session := mk_Session(0, 0, 0, 0, 0, 0);
    )
    pre current_session.stage = 3;

functions
    -- モジュラス10ウェイト3・1 計算
    public CheckDigit: nat * nat * nat -> nat
    CheckDigit(comp_code, cust_id, amt) ==
        (10 - (
               ((amt mod 10)*3 +
                ((amt div 10) mod 10)*1 +
                ((amt div 100) mod 10)*3 +
                ((amt div 1000) mod 10)*1 +
                ((amt div 10000) mod 10)*3 +
                ((amt div 100000) mod 10)*1) +

               ((cust_id mod 10)*3 +
                ((cust_id div 10) mod 10)*1 +
                ((cust_id div 100) mod 10)*3 +
                ((cust_id div 1000) mod 10)*1 +
                ((cust_id div 10000) mod 10)*3 +
                ((cust_id div 100000) mod 10)*1) +

               ((comp_code mod 10)*3 +
                ((comp_code div 10) mod 10)*1 +
                ((comp_code div 100) mod 10)*3 +
                ((comp_code div 1000) mod 10)*1 +
                ((comp_code div 10000) mod 10)*3 +
                ((comp_code div 100000) mod 10)*1)
        ) mod 10) mod 10;

end ConveniPayment44
