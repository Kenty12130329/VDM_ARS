-- =======================================
-- エラーあり版 (TestSetHard.vdmpp)
-- CopyAtoBにバグがあり、不変条件違反が発生する
-- =======================================

class TestSetHard

instance variables
    -- 2つのグループ。初期状態では混ざっていない。
    public set_A : set of int := {1, 2, 3};
    public set_B : set of int := {10, 20};

    -- 不変条件: AとBの共通部分(intersection)は空集合であること
    inv set_A inter set_B = {};

operations
    -- [Safe] AからBへ要素を正しく「移動」する
    public MoveAtoB: int ==> ()
    MoveAtoB(x) == (
        if x in set set_A then (
            set_A := set_A \ {x};      -- 削除
            set_B := set_B union {x};  -- 追加
        )
    );

    -- [Unsafe] Aの内容をBに「コピー」（バグあり）
    -- Aから削除し忘れ → 不変条件違反！
    public CopyAtoB: int ==> ()
    CopyAtoB(x) == (
        if x in set set_A then (
            -- set_A := set_A \ {x};  <-- 削除を忘れている！
            set_B := set_B union {x};
        )
    );

end TestSetHard
