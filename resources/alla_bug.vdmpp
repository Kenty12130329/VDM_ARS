class alla_bug



types

    -- dfのtypesの部分
    public stockProduct::
        product : token
        stock : int;

    public completedProductNumber::
        material : token
        product : token
        productNum : int;

    public stockMaterial::
        material : token
        stock : int;

    public rankDiscount::
        rankNumber : int
        discount : rat;

    public saleItems::
        product : token
        price : int
        flag : bool;


    -- dfのtokenの内容
    public deliveryPerson::

        deliveryPersonId : int
        processCustomerId : [int]
        deliveryProduct : [token]
        delieveryFlag : [bool];

    public employee::

        employeeId : int
        processCustomerId : [int]
        processProduct : [token]
        newStockNum : [int]
        delieveryFlag : [bool];

    public produceMachine::

        produceMachineId : int
        processCustomerId : [int]
        produceProduct : [token]
        produceNum : [int];

    public customer::

        customerId : int
        balance : int
        rank : int;



instance variables
    public history : seq of token := [];
-- dfに保存されている大域変数
    public rankDiscountSet : set of rankDiscount := {mk_rankDiscount(0, 1), mk_rankDiscount(1, 0.8)};
    public saleItemsSet : set of saleItems := {mk_saleItems(mk_token("product1"), 100, true), mk_saleItems(mk_token("product2"), 200, true)};
    public stockProductSet : set of stockProduct := {mk_stockProduct(mk_token("product1"), 2), mk_stockProduct(mk_token("product2"), 1)};
    public stockMaterialSet : set of stockMaterial := {mk_stockMaterial(mk_token("material1"), 5), mk_stockMaterial(mk_token("material2"), 5)};
    public completedProductNumberSet : set of completedProductNumber := {mk_completedProductNumber(mk_token("material1"), mk_token("product1"), 1), mk_completedProductNumber(mk_token("material2"), mk_token("product2"), 2)};

-- placeとして作成する大域変数
    -- ===== 深さ3で検出されるバグのシナリオ =====
    -- 顧客0: 残高100円、ランク0
    -- 深さ1: order(product1) → 100*1.0=100円引き落とし → 残高0円 → promotionDecisionStateへ
    -- 深さ2: rankUp(true) → ランク1に昇格 → menuStateへ戻る（残高0円のまま）
    -- 深さ3: order(product1) → 事前条件: 100*0.8=80円 <= 0円 → NG（正常にブロック）
    --
    -- 顧客1: 残高199円、ランク0
    -- 深さ1: order(product1) → 100*1.0=100円引き落とし → 残高99円 → promotionDecisionStateへ
    -- 深さ2: rankUp(true) → ランク1に昇格 → menuStateへ戻る（残高99円）
    -- 深さ3: order(product1) → 事前条件: 100*0.8=80円 <= 99円 → OK!
    --        引き落とし: 100*0.8=80円 → 残高19円 → 正常
    -- 深さ4: order(product1) → 事前条件: 80円 <= 19円 → NG
    --
    -- よって、通常のフローでは深さ3-4でも違反は起きない
    -- バグを仕込む: addBalance操作で負の値を許可してしまう
    public menuState : set of customer := {mk_customer(0, 100, 0),mk_customer(1, 199, 0)};
    public promotionDecisionState : set of customer := {};
    public managementState : set of employee := {mk_employee(0, nil, nil, nil, nil),mk_employee(1, nil, nil, nil, nil)};
    public orderAcceptanceState : set of employee := {};
    public previousProduceState : set of employee := {};
    public waitingProduceState : set of employee := {};
    public checkingProduceState : set of employee := {};
    public checkingDeliveryState : set of employee := {};
    public waitingDeliveryState : set of employee := {};
    public previousDeliveryState : set of employee := {};
    public readyProduceState : set of produceMachine := {mk_produceMachine(0, nil, nil, nil)};
    public produceResultCheckState : set of produceMachine := {};
    public beforeProduceResultFlagSendState : set of produceMachine := {};
    public delieveryResultCheckState : set of deliveryPerson := {};
    public readyDelieveryState : set of deliveryPerson := {mk_deliveryPerson(0, nil, nil, nil)};
    public beforeDelieveryResultFlagSendState : set of deliveryPerson := {};
    public closureState : set of employee := {};

-- dfに保存されている大域変数の不変条件
                    
-- placeの不変条件
-- バグ検出用: 顧客の残高が負になってはならない
    inv forall c in set menuState & c.balance >= 0
    and forall c in set promotionDecisionState & c.balance >= 0


operations

    public failureDelivery:  () ==> ()
        failureDelivery() == (
            dcl at_checkingDeliveryState: employee := 
                let at in set checkingDeliveryState be st 
                    at.delieveryFlag = false 
                in at;
            -- delete token
            checkingDeliveryState := checkingDeliveryState \ {at_checkingDeliveryState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("failureDelivery_0")]; at_checkingDeliveryState.delieveryFlag := nil;
            -- additional token
            orderAcceptanceState := orderAcceptanceState union {at_checkingDeliveryState};
        )
        pre
            exists employee in set checkingDeliveryState & employee.delieveryFlag = false;

    public checkNoItems:  () ==> ()
        checkNoItems() == (
            dcl at_orderAcceptanceState: employee := 
                let at in set orderAcceptanceState be st 
                    exists item in set stockProductSet & item.product = at.processProduct and item.stock = 0 
                in at;
            -- delete token
            orderAcceptanceState := orderAcceptanceState \ {at_orderAcceptanceState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("checkNoItems_0")]; 
            -- additional token
            previousProduceState := previousProduceState union {at_orderAcceptanceState};
        )
        pre
            exists employee in set orderAcceptanceState & exists item in set stockProductSet & item.product = employee.processProduct and item.stock = 0;

    public receptionProduce:  () ==> ()
        receptionProduce() == (
            dcl at_previousProduceState: employee := 
                let at in set previousProduceState in at;
            dcl at_readyProduceState: produceMachine := 
                let at in set readyProduceState in at;
            -- delete token
            previousProduceState := previousProduceState \ {at_previousProduceState};
            readyProduceState := readyProduceState \ {at_readyProduceState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("receptionProduce_0")]; at_readyProduceState.processCustomerId := at_previousProduceState.processCustomerId;
            at_readyProduceState.produceProduct := at_previousProduceState.processProduct;
            -- additional token
            waitingProduceState := waitingProduceState union {at_previousProduceState};
            produceResultCheckState := produceResultCheckState union {at_readyProduceState};
        );

    public notifyProduceResult:  () ==> ()
        notifyProduceResult() == (
            dcl at_waitingProduceState: employee := 
                let at in set waitingProduceState in at;
            dcl at_beforeProduceResultFlagSendState: produceMachine := 
                let at in set beforeProduceResultFlagSendState be st 
                    at.processCustomerId = at_waitingProduceState.processCustomerId 
                in at;
            -- delete token
            waitingProduceState := waitingProduceState \ {at_waitingProduceState};
            beforeProduceResultFlagSendState := beforeProduceResultFlagSendState \ {at_beforeProduceResultFlagSendState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("notifyProduceResult_0")]; at_waitingProduceState.newStockNum := at_beforeProduceResultFlagSendState.produceNum; -- 生産した数を受け渡す
            -- 生産機械の情報を初期値に戻す
            at_beforeProduceResultFlagSendState.processCustomerId := nil;    -- 対応している客のid
            at_beforeProduceResultFlagSendState.produceProduct := nil;    -- 生産する商品名
            at_beforeProduceResultFlagSendState.produceNum := nil;     -- 生産が成功した数
            -- additional token
            checkingProduceState := checkingProduceState union {at_waitingProduceState};
            readyProduceState := readyProduceState union {at_beforeProduceResultFlagSendState};
        )
        pre
            exists x in set waitingProduceState & exists y in set beforeProduceResultFlagSendState & x.processCustomerId = y.processCustomerId;

    public checkItems:  () ==> ()
        checkItems() == (
            dcl at_orderAcceptanceState: employee := 
                let at in set orderAcceptanceState be st 
                    exists item in set stockProductSet & item.product = at.processProduct and item.stock > 0 
                in at;
            -- delete token
            orderAcceptanceState := orderAcceptanceState \ {at_orderAcceptanceState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("checkItems_0")]; 
            -- additional token
            previousDeliveryState := previousDeliveryState union {at_orderAcceptanceState};
        )
        pre
            exists employee in set orderAcceptanceState & exists item in set stockProductSet & item.product = employee.processProduct and item.stock > 0;

    public notifyDeliveryResult:  () ==> ()
        notifyDeliveryResult() == (
            dcl at_waitingDeliveryState: employee := 
                let at in set waitingDeliveryState in at;
            dcl at_beforeDelieveryResultFlagSendState: deliveryPerson := 
                let at in set beforeDelieveryResultFlagSendState be st 
                    at.processCustomerId = at_waitingDeliveryState.processCustomerId 
                in at;
            -- delete token
            waitingDeliveryState := waitingDeliveryState \ {at_waitingDeliveryState};
            beforeDelieveryResultFlagSendState := beforeDelieveryResultFlagSendState \ {at_beforeDelieveryResultFlagSendState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("notifyDeliveryResult_0")]; at_waitingDeliveryState.delieveryFlag := at_beforeDelieveryResultFlagSendState.delieveryFlag;
            at_beforeDelieveryResultFlagSendState.processCustomerId := nil;
            at_beforeDelieveryResultFlagSendState.deliveryProduct := nil;
            at_beforeDelieveryResultFlagSendState.delieveryFlag := nil;
            -- additional token
            checkingDeliveryState := checkingDeliveryState union {at_waitingDeliveryState};
            readyDelieveryState := readyDelieveryState union {at_beforeDelieveryResultFlagSendState};
        )
        pre
            exists employee in set waitingDeliveryState &
            exists deliveryPerson in set beforeDelieveryResultFlagSendState &
            employee.processCustomerId = deliveryPerson.processCustomerId;

    public delivery:  () ==> ()
        delivery() == (
            dcl at_delieveryResultCheckState: deliveryPerson := 
                let at in set delieveryResultCheckState in at;
            -- delete token
            delieveryResultCheckState := delieveryResultCheckState \ {at_delieveryResultCheckState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("delivery_0")]; at_delieveryResultCheckState.delieveryFlag := true;
            -- additional token
            beforeDelieveryResultFlagSendState := beforeDelieveryResultFlagSendState union {at_delieveryResultCheckState};
        );

    public canNotDelivery:  () ==> ()
        canNotDelivery() == (
            dcl at_delieveryResultCheckState: deliveryPerson := 
                let at in set delieveryResultCheckState in at;
            -- delete token
            delieveryResultCheckState := delieveryResultCheckState \ {at_delieveryResultCheckState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("canNotDelivery_0")]; at_delieveryResultCheckState.delieveryFlag := false;
            -- additional token
            beforeDelieveryResultFlagSendState := beforeDelieveryResultFlagSendState union {at_delieveryResultCheckState};
        );

    public produce:  () ==> ()
        produce() == (
            dcl at_produceResultCheckState: produceMachine := 
                let at in set produceResultCheckState be st 
                    exists item1 in set completedProductNumberSet & item1.product = at.produceProduct and exists item2 in set stockMaterialSet & item1.material = item2.material and item2.stock > 0 
                in at;
            dcl item : stockMaterial :=     let item2 in set stockMaterialSet be st         exists item1 in set completedProductNumberSet & item1.product = at_produceResultCheckState.produceProduct and item1.material = item2.material       in item2;
            -- delete token
            produceResultCheckState := produceResultCheckState \ {at_produceResultCheckState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("produce_0")]; 
            at_produceResultCheckState.produceNum :=
                let item1 in set completedProductNumberSet be st
                    item1.product = at_produceResultCheckState.produceProduct
                in item1.productNum;     -- 生産が成功した数だけ代入する
            stockMaterialSet := stockMaterialSet \ {item};
            item.stock := item.stock - 1; -- 材料の在庫数を１つ減らす
            stockMaterialSet := stockMaterialSet union {item};
            -- additional token
            beforeProduceResultFlagSendState := beforeProduceResultFlagSendState union {at_produceResultCheckState};
        )
        pre
            exists at in set produceResultCheckState & exists item1 in set completedProductNumberSet & item1.product = at.produceProduct and
                        exists item2 in set stockMaterialSet & item1.material = item2.material and item2.stock > 0;

    public deliverySuccess:  () ==> ()
        deliverySuccess() == (
            dcl at_checkingDeliveryState: employee := 
                let at in set checkingDeliveryState be st 
                    at.delieveryFlag = true 
                in at;
            -- delete token
            checkingDeliveryState := checkingDeliveryState \ {at_checkingDeliveryState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("deliverySuccess_0")]; at_checkingDeliveryState.processCustomerId := nil;
            at_checkingDeliveryState.processProduct := nil;
            at_checkingDeliveryState.delieveryFlag := nil;
            -- additional token
            managementState := managementState union {at_checkingDeliveryState};
        )
        pre
            exists employee in set checkingDeliveryState & employee.delieveryFlag = true;

    public canNotProduce:  () ==> ()
        canNotProduce() == (
            dcl at_produceResultCheckState: produceMachine := 
                let at in set produceResultCheckState be st 
                    exists item1 in set completedProductNumberSet & item1.product = at.produceProduct and exists item2 in set stockMaterialSet & item1.material = item2.material and item2.stock = 0 
                in at;
            -- delete token
            produceResultCheckState := produceResultCheckState \ {at_produceResultCheckState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("canNotProduce_0")]; at_produceResultCheckState.produceNum := 0;     -- 生産が成功した数だけ代入する(今回は失敗なので０)
            -- additional token
            beforeProduceResultFlagSendState := beforeProduceResultFlagSendState union {at_produceResultCheckState};
        )
        pre
            exists at in set produceResultCheckState & exists item1 in set completedProductNumberSet & item1.product = at.produceProduct and exists item2 in set stockMaterialSet & item1.material = item2.material and item2.stock = 0;

    public rankUp:  bool ==> ()
        rankUp(rankUpFlag) == (
            dcl at_promotionDecisionState: customer := 
                let at in set promotionDecisionState in at;
            -- delete token
            promotionDecisionState := promotionDecisionState \ {at_promotionDecisionState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("rankUp_0")]; if rankUpFlag = true and exists rank in set rankDiscountSet & rank.rankNumber = at_promotionDecisionState.rank + 1
            then( history := history ^ [mk_token("rankUp_1")];  at_promotionDecisionState.rank := at_promotionDecisionState.rank + 1;)
            else( history := history ^ [mk_token("rankUp_2")];  at_promotionDecisionState.rank := at_promotionDecisionState.rank;);
            -- additional token
            menuState := menuState union {at_promotionDecisionState};
        )
        pre
            -- promotionDecisionStateに顧客がいることが必要（orderの後でのみ実行可能）
            -- <> 演算子の代わりに exists を使用（Z3で変換可能にするため）
            exists customer in set promotionDecisionState & true;

    public moveToDeliveryProductStep:  () ==> ()
        moveToDeliveryProductStep() == (
            dcl at_checkingProduceState: employee := 
                let at in set checkingProduceState be st 
                    at.newStockNum > 0 
                in at;
            dcl item : stockProduct := let item in set stockProductSet be st item.product = at_checkingProduceState.processProduct in item;
            -- delete token
            checkingProduceState := checkingProduceState \ {at_checkingProduceState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("moveToDeliveryProductStep_0")]; 
            stockProductSet := stockProductSet \ {item};
            item.stock := item.stock + at_checkingProduceState.newStockNum; -- 在庫数を生産数だけ増やす
            stockProductSet := stockProductSet union {item};
            at_checkingProduceState.newStockNum := nil;   -- 生産数をnilにする（生産していない状況にする）
            -- additional token
            previousDeliveryState := previousDeliveryState union {at_checkingProduceState};
        )
        pre
            exists employee in set checkingProduceState & employee.newStockNum > 0;

    -- ===== バグ: 負のamountを許可してしまう =====
    -- 本来は「amount > 0」をチェックすべき
    -- 
    -- シナリオ（深さ3で検出）:
    -- 深さ1: order(product1) → 顧客の残高が減る → promotionDecisionStateへ
    -- 深さ2: rankUp(true) → ランク1に昇格 → menuStateへ戻る
    -- 深さ3: addBalance(-200) → 残高が負になる！ → 不変条件違反
    public addBalance:  int ==> ()
        addBalance(amount) == (
            dcl at_menuState: customer := 
                let at in set menuState be st 
                    at.balance <= 1000 and at.rank >= 1  -- ランク1以上の顧客のみ追加入金可能
                in at;
            -- delete token
            menuState := menuState \ {at_menuState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("addBalance_0")]; 
            at_menuState.balance := at_menuState.balance + amount;  -- amountが負でも加算してしまう！
            -- additional token
            menuState := menuState union {at_menuState};
        )
        pre
            -- バグ: amount > 0 のチェックがない！
            -- 正常条件: ランク1以上の顧客がmenuStateにいる（order+rankUp後のみ満たされる）
            exists x in set menuState & x.balance <= 1000 and x.rank >= 1;

    public refundAndStopSelling:  () ==> ()
        refundAndStopSelling() == (
            dcl at_checkingProduceState: employee := 
                let at in set checkingProduceState be st 
                    at.newStockNum = 0 
                in at;
            dcl at_menuState: customer := 
                let at in set menuState be st 
                    at.customerId = at_checkingProduceState.processCustomerId 
                in at;
            dcl item : saleItems := let item in set saleItemsSet be st item.product = at_checkingProduceState.processProduct in item;
            -- delete token
            checkingProduceState := checkingProduceState \ {at_checkingProduceState};
            menuState := menuState \ {at_menuState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("refundAndStopSelling_0")]; 
            saleItemsSet := saleItemsSet \ {item};
            item.flag := false;
            saleItemsSet := saleItemsSet union {item};
            at_menuState.balance := at_menuState.balance +
                let item in set saleItemsSet be st
                    item.product = at_checkingProduceState.processProduct  --返金処理（商品の金額だけ残高を増加させる）
                in item.price; -- 従業員の情報を初期値に戻す
            at_checkingProduceState.processCustomerId := nil;    -- 対応している客のid
            at_checkingProduceState.processProduct := nil;    -- 購入されたものを受け取り処理する商品
            at_checkingProduceState.newStockNum := nil;        -- 新しく生産して増加した在庫の数
            at_checkingProduceState.delieveryFlag := nil;     -- 配送が成功したかどうかのフラグ
            -- additional token
            managementState := managementState union {at_checkingProduceState};
            menuState := menuState union {at_menuState};
        )
        pre
            exists employee in set checkingProduceState & employee.newStockNum = 0 and exists customer in set menuState & customer.customerId = employee.processCustomerId;

    public moveToClosureState:  () ==> ()
        moveToClosureState() == (
            dcl at_managementState: employee := 
                let at in set managementState in at;
            -- delete token
            managementState := managementState \ {at_managementState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("moveToClosureState_0")]; 
            -- additional token
            closureState := closureState union {at_managementState};
        )
        pre
            forall item in set saleItemsSet & item.flag = false;

    public receptionDelivery:  () ==> ()
        receptionDelivery() == (
            dcl at_previousDeliveryState: employee := 
                let at in set previousDeliveryState be st 
                    let item in set stockProductSet be st item.product = at.processProduct in item.stock > 0 
                in at;
            dcl at_readyDelieveryState: deliveryPerson := 
                let at in set readyDelieveryState in at;
            dcl item : stockProduct :=     let item in set stockProductSet be st         item.product = at_previousDeliveryState.processProduct     in item;
            -- delete token
            previousDeliveryState := previousDeliveryState \ {at_previousDeliveryState};
            readyDelieveryState := readyDelieveryState \ {at_readyDelieveryState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("receptionDelivery_0")]; 

            at_readyDelieveryState.processCustomerId := at_previousDeliveryState.processCustomerId;    -- 対応している客のid
            at_readyDelieveryState.deliveryProduct := at_previousDeliveryState.processProduct;  -- 配達する商品
            stockProductSet := stockProductSet \ {item};
            item.stock := item.stock - 1; -- 在庫数を１つ減らす
            stockProductSet := stockProductSet union {item};
            -- additional token
            waitingDeliveryState := waitingDeliveryState union {at_previousDeliveryState};
            delieveryResultCheckState := delieveryResultCheckState union {at_readyDelieveryState};
        )
        pre
            exists x in set previousDeliveryState & exists item in set stockProductSet & item.product = x.processProduct and item.stock > 0;

    public order:  token ==> ()
        order(chooseProduct) == (
            dcl at_menuState: customer := 
                let at in set menuState be st 
                    at.balance >= let item in set saleItemsSet be st item.product = chooseProduct in item.price * let rank in set rankDiscountSet be st rank.rankNumber = at.rank in rank.discount 
                in at;
            dcl at_managementState: employee := 
                let at in set managementState in at;
            -- delete token
            menuState := menuState \ {at_menuState};
            managementState := managementState \ {at_managementState};
            history := [];  -- 次の行からaction
            history := history ^ [mk_token("order_0")];
            -- 正常: 割引を適用して引き落とし
            at_menuState.balance := at_menuState.balance -
            let item in set saleItemsSet be st
                item.product = chooseProduct
            in item.price *
            let rank in set rankDiscountSet be st
                rank.rankNumber = at_menuState.rank in rank.discount;
            at_managementState.processCustomerId := at_menuState.customerId;
            at_managementState.processProduct := chooseProduct;
            -- additional token
            promotionDecisionState := promotionDecisionState union {at_menuState};
            orderAcceptanceState := orderAcceptanceState union {at_managementState};
        )
        pre
            exists item in set saleItemsSet & item.product = chooseProduct and item.flag = true and 
            exists customer in set menuState & 
                customer.balance >= let i in set saleItemsSet be st i.product = chooseProduct in i.price * 
                                    let r in set rankDiscountSet be st r.rankNumber = customer.rank in r.discount;


functions

    

end alla_bug
