-- ================================================================
-- M11
-- 
-- 【注入されたバグ】
-- 複合条件バグ (Deep Bug):
-- return_book 操作において、システムの稼働時間が長い（historyが一定以上）場合のみ、
-- 貸出記録の削除を失敗する（学生の手元に本が残るが、図書館側は返却済み扱いになる）。
--
-- 条件: len history >= 5 (深さ5以降で発現)
--
-- 検出用不変条件:
-- 学生が借りている本は、必ず borrowed_books (貸出中リスト) に存在しなければならない。
-- ================================================================

class book_M11

types

    public book::
        book_name : token
        borrower_name : [token];

    public student::
        num : nat
        student_or_not : bool
        human_name : token
        borrowing_books : set of token
        login_or_not : bool;

instance variables
    public history : seq of token := [];
    public starting : set of student := {};
    public student_login_status : set of student := {mk_student(1, true, mk_token("sato"), {}, false), mk_student(2, true, mk_token("suzuki"), {}, false)};
    public borrowable_books : set of book := {mk_book(mk_token("book_A"), nil), mk_book(mk_token("book_B"), nil)};
    public borrowed_books : set of book := {};
    public guest_user_login_status : set of student := {};
    public continued_login_confirmation : set of student := {};

    -- 不変条件: 
    -- 1. 1人が同時に借りられるのは1冊まで
    -- 2. 本の総数は常に一定(2冊) (Base M8 check)
    -- 3. [NEW] 整合性チェック: 学生が持っている本は、必ず「貸出中(borrowed_books)」になっていること
    inv (forall s in set student_login_status & card(s.borrowing_books) <= 1)
        and (card(borrowed_books union borrowable_books) = 2)
        and (forall s in set student_login_status & 
               forall b_name in set s.borrowing_books & 
                 exists b in set borrowed_books & b.book_name = b_name);

operations

    public admission:  () ==> ()
        admission() == (
            dcl at_starting: student := 
                let at in set starting be st 
                    forall p in set starting & at.num <= p.num 
                in at;
            starting := starting \ {at_starting};
            history := history ^ [mk_token("admission_0")]; at_starting.student_or_not := true;
            starting := starting union {at_starting};
        )
        pre
            (let at in set starting be st forall p in set starting & at.num <= p.num in at).student_or_not = false;

    public return_book:  token ==> ()
        return_book(return_booking) == (
            dcl at_student_login_status: student := 
                let at in set student_login_status be st 
                    return_booking in set at.borrowing_books 
                in at;
            dcl at_borrowed_books: book := 
                let at in set borrowed_books be st 
                    at.book_name = return_booking  
                in at;
            
            student_login_status := student_login_status \ {at_student_login_status};
            borrowed_books := borrowed_books \ {at_borrowed_books};
            
            history := history ^ [mk_token("return_book_0")]; 
            at_borrowed_books.borrower_name := nil;

            -- BUG INJECTION: 深さが浅い(history < 5)うちは正常に返却処理するが、
            -- 深くなると学生の借用リストから削除するのを忘れる
            if len history < 5 then
                at_student_login_status.borrowing_books := at_student_login_status.borrowing_books \ {return_booking}
            else
                skip; -- バグ: 削除しない

            continued_login_confirmation := continued_login_confirmation union {at_student_login_status};
            borrowable_books := borrowable_books union {at_borrowed_books};
        )
        pre
            exists x in set student_login_status & return_booking in set x.borrowing_books;

    public continue:  () ==> ()
        continue() == (
            dcl at_continued_login_confirmation: student := 
                let at in set continued_login_confirmation in at;
            continued_login_confirmation := continued_login_confirmation \ {at_continued_login_confirmation};
            history := history ^ [mk_token("continue_0")]; 
            student_login_status := student_login_status union {at_continued_login_confirmation};
        );

    public expulsion:  () ==> ()
        expulsion() == (
            dcl at_starting: student := 
                let at in set starting be st 
                    forall p in set starting & at.num <= p.num 
                in at;
            starting := starting \ {at_starting};
            history := history ^ [mk_token("expulsion_0")]; at_starting.student_or_not := false;
            starting := starting union {at_starting};
        )
        pre
            ((let at in set starting be st forall p in set starting & at.num <= p.num in at).student_or_not = true) and (card ((let at in set starting be st forall p in set starting & at.num <= p.num in at).borrowing_books) = 0);

    public login_as_a_guest_user:  () ==> ()
        login_as_a_guest_user() == (
            dcl at_starting: student := 
                let at in set starting be st 
                    forall p in set starting & at.num <= p.num 
                in at;
            starting := starting \ {at_starting};
            history := history ^ [mk_token("login_as_a_guest_user_0")]; at_starting.login_or_not := true;
            guest_user_login_status := guest_user_login_status union {at_starting};
        )
        pre
            ((let at in set starting be st forall p in set starting & at.num <= p.num in at).student_or_not = false);

    public logout_guest_user:  () ==> ()
        logout_guest_user() == (
            dcl at_guest_user_login_status: student := 
                let at in set guest_user_login_status in at;
            guest_user_login_status := guest_user_login_status \ {at_guest_user_login_status};
            history := history ^ [mk_token("logout_guest_user_0")]; at_guest_user_login_status.login_or_not := false;
            starting := starting union {at_guest_user_login_status};
        );

    public borrow_book:  token ==> ()
        borrow_book(borrow_booking) == (
            dcl at_student_login_status: student := 
                let at in set student_login_status be st 
                    card(at.borrowing_books) = 0
                in at;
            dcl at_borrowable_books: book := 
                let at in set borrowable_books be st 
                    at.book_name = borrow_booking 
                in at;
            student_login_status := student_login_status \ {at_student_login_status};
            borrowable_books := borrowable_books \ {at_borrowable_books};
            
            history := history ^ [mk_token("borrow_book_0")]; at_borrowable_books.borrower_name := at_student_login_status.human_name;
            at_student_login_status.borrowing_books := at_student_login_status.borrowing_books union {at_borrowable_books.book_name};
            
            -- 不変条件チェック用に再追加
            student_login_status := student_login_status union {at_student_login_status};

            continued_login_confirmation := continued_login_confirmation union {at_student_login_status};
            borrowed_books := borrowed_books union {at_borrowable_books};
        )
        pre exists x in set student_login_status & card(x.borrowing_books) = 0;

    public login_as_a_student:  () ==> ()
        login_as_a_student() == (
            dcl at_starting: student := 
                let at in set starting be st 
                    forall p in set starting & at.num <= p.num 
                in at;
            starting := starting \ {at_starting};
            history := history ^ [mk_token("login_as_a_student_0")]; 
            student_login_status := student_login_status union {at_starting};
        )
        pre
            ((let at in set starting be st forall p in set starting & at.num <= p.num in at).student_or_not = true);

    public logout_student:  () ==> ()
        logout_student() == (
            dcl at_continued_login_confirmation: student := 
                let at in set continued_login_confirmation in at;
            continued_login_confirmation := continued_login_confirmation \ {at_continued_login_confirmation};
            history := history ^ [mk_token("logout_student_0")]; at_continued_login_confirmation.login_or_not := false;
            starting := starting union {at_continued_login_confirmation};
        )
        pre
            forall a in set continued_login_confirmation & a.login_or_not = true;

end book_M11
