-- MiniLibrary: Map + Record + Set の入れ子構造テスト
-- 目的: 複雑なデータ構造の更新処理と不変条件監視の統合テスト

class MiniLibrary

types
    -- ユーザーレコード: 名前と借りている本のID集合
    public User ::
        name : seq of char
        borrowed : set of int;

instance variables
    -- 会員IDからUserレコードへのマップ
    public user_db : map int to User := {
        1 |-> mk_User("Alice", {100}),  -- Aliceは既に1冊所持
        2 |-> mk_User("Bob", {})         -- Bobは本を借りていない
    };

    -- 不変条件: 全ユーザーの借りている本は2冊以下
    inv forall id in set dom user_db & 
        card(user_db(id).borrowed) <= 2;

operations
    -- [Safe] 本を借りる操作
    -- userId: 会員ID, bookId: 本のID
    public Borrow: int * int ==> ()
    Borrow(userId, bookId) == (
        dcl u : User;
        -- マップにユーザーが存在する場合のみ処理
        if userId in set dom user_db then (
            -- 1. マップからUserレコードを取得
            u := user_db(userId);
            
            -- 2. borrowedセットに本を追加
            u.borrowed := u.borrowed union {bookId};
            
            -- 3. 更新したレコードをマップに書き戻す
            user_db(userId) := u;
        )
    );

    -- [Unsafe] 不変条件違反を意図的に引き起こすテスト操作
    -- Alice (ID 1) に3冊設定する（違反！）
    public ForceError: () ==> ()
    ForceError() == (
        dcl u : User;
        -- Alice (ID 1) を取得
        u := user_db(1);
        
        -- 直接3冊設定（union演算の翻訳問題を回避）
        u.borrowed := {100, 200, 300};
        
        -- マップに書き戻す
        user_db(1) := u;
    );

end MiniLibrary
