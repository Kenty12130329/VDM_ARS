-- ============================================================
-- コンビニ収納代行システム (外部引数版 - Type A)
-- ConveniPayment_bug_A.vdmpp
-- 
-- 安全性違反 (Safety Violation):
-- 支払い(pay)実行時に、支払った請求書を
-- 「未払いリスト(pending_invoices)」から削除し忘れる。
-- これにより、同じ請求書が「未払い」と「支払い済み」の両方に存在することになり、
-- 不変条件 (inv) に違反する。
-- ============================================================

class ConveniPayment

types
    -- 請求データレコード
    public invoice::
        invoice_id : nat
        amount : nat;

instance variables
    -- 未払い請求データベース
    public pending_invoices : set of invoice := {
        mk_invoice(123456, 3000),   -- CD=5
        mk_invoice(234567, 5500),   -- CD=6
        mk_invoice(345678, 12000)   -- CD=7
    };
    
    -- 支払済み請求
    public paid_invoices : set of invoice := {};

    -- 不変条件: 同一IDが二重に存在しない
    inv forall p in set pending_invoices, q in set paid_invoices &
        p.invoice_id <> q.invoice_id;

operations
    -- ============================================================
    -- 支払いオペレーション (pay)
    -- ============================================================
    public pay: nat * nat * nat ==> ()
    pay(target_id, target_amount, check_digit) == (
        dcl target_invoice: invoice := mk_invoice(target_id, target_amount);
        
        -- バグ: 未払いリストから削除し忘れる (不変条件違反の原因)
        -- pending_invoices := pending_invoices \ {target_invoice};
        paid_invoices := paid_invoices union {target_invoice}
    )
    pre 
        -- ガード条件A: モジュラス10 チェックデジット検証
        check_digit = (10 - ((target_id mod 10) * 3 + 
                            ((target_id div 10) mod 10) * 1 + 
                            ((target_id div 100) mod 10) * 3 + 
                            ((target_id div 1000) mod 10) * 1 + 
                            ((target_id div 10000) mod 10) * 3 + 
                            ((target_id div 100000) mod 10) * 1) mod 10) mod 10
        and
        -- ガード条件B: DB照合
        mk_invoice(target_id, target_amount) in set pending_invoices;

end ConveniPayment
