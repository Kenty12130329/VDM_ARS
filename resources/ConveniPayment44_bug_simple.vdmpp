-- ================================================================
-- コンビニ収納代行システム -  (Simple Bug)
-- ConveniPayment44_bug_simple.vdmpp
-- ================================================================

class ConveniPayment44

types
    -- 請求データベースレコード
    public invoice::
        company_code : nat
        customer_id : nat
        amount : nat;

instance variables
    -- 未払い請求データベース
    public pending_invoices : set of invoice := {
        mk_invoice(123456, 100001, 3000),   -- CD=8
        mk_invoice(123456, 100002, 5500),   -- CD=8
        mk_invoice(789012, 200001, 12000)   -- CD=3
    };
    
    -- 支払済み請求
    public paid_invoices : set of invoice := {};

    -- 不変条件: 同一請求が未払いと支払済みに同時存在してはならない
    inv forall p in set pending_invoices, q in set paid_invoices &
        not (p.company_code = q.company_code and p.customer_id = q.customer_id);

operations
    -- ================================================================
    -- 【バグあり】支払いオペレーション
    -- ================================================================
    -- バグ: pending_invoicesから削除し忘れ → 不変条件違反！
    -- ================================================================
    public paySimple_buggy: nat * nat * nat * nat ==> ()
    paySimple_buggy(comp_code, cust_id, amt, cd) == (
        dcl target_inv: invoice := mk_invoice(comp_code, cust_id, amt);
        
        -- バグ: 未払いリストから削除しない
        -- pending_invoices := pending_invoices \ {target_inv};
        
        -- 支払済みに追加（削除せずに追加 → 不変条件違反）
        paid_invoices := paid_invoices union {target_inv}
    )
    pre
        -- 正しいチェックデジット計算 (モジュラス10ウェイト3・1)
        cd = (10 - (
                -- Amount (下位6桁): Weights 3,1,3,1,3,1
                   ((amt mod 10)*3 +
                    ((amt div 10) mod 10)*1 +
                    ((amt div 100) mod 10)*3 +
                    ((amt div 1000) mod 10)*1 +
                    ((amt div 10000) mod 10)*3 +
                    ((amt div 100000) mod 10)*1) +

                -- Customer ID (中位6桁): Weights 3,1,3,1,3,1
                   ((cust_id mod 10)*3 +
                    ((cust_id div 10) mod 10)*1 +
                    ((cust_id div 100) mod 10)*3 +
                    ((cust_id div 1000) mod 10)*1 +
                    ((cust_id div 10000) mod 10)*3 +
                    ((cust_id div 100000) mod 10)*1) +

                -- Company Code (上位6桁): Weights 3,1,3,1,3,1
                   ((comp_code mod 10)*3 +
                    ((comp_code div 10) mod 10)*1 +
                    ((comp_code div 100) mod 10)*3 +
                    ((comp_code div 1000) mod 10)*1 +
                    ((comp_code div 10000) mod 10)*3 +
                    ((comp_code div 100000) mod 10)*1)
                ) mod 10) mod 10
        and
        -- ガード条件B: DB照合
        mk_invoice(comp_code, cust_id, amt) in set pending_invoices;

end ConveniPayment44
