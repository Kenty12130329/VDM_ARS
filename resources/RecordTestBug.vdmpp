-- =======================================
-- エラーあり版 (RecordTestBug.vdmpp)
-- addBookのガードが欠落しており、2冊目を借りられる
-- → 不変条件(1人1冊)に違反！
-- =======================================

class RecordTest

types
    public Token = token;
    public book :: 
        name : Token
        borrower_name : [Token];

    public Person ::
        name : Token
        books : set of Token;

instance variables
    -- 在庫を3冊に増やす（addBook->addBookで2冊借りられるように）
    public borrowable_books : set of book := {mk_book(mk_token("book_A"), nil), mk_book(mk_token("book_B"), nil), mk_book(mk_token("book_C"), nil)};
    public group : set of Person := {mk_Person(mk_token("user1"), {})};
    
    -- 不変条件: 1人1冊まで
    inv forall p in set group & card(p.books) <= 1;

operations
    -- [Unsafe] 本を追加（ガードなし → 2冊目も借りられる）
    public addBook: () ==> ()
    addBook() == (
        dcl b : book;
        dcl p : Person;
        
        b := let x in set borrowable_books in x;
        p := let y in set group in y;  -- ガードなし！誰でも借りられる
        
        borrowable_books := borrowable_books \ {b};
        group := group \ {p};
        
        p.books := p.books union {b.name};  -- 2冊目が追加される
        
        group := group union {p};
    )
    pre borrowable_books <> {};

    -- [Safe] 本を返却
    public returnBook: () ==> ()
    returnBook() == (
        dcl p : Person;
        dcl t : Token;
        dcl b : book;
        
        p := let y in set group be st card(y.books) > 0 in y;
        t := let x in set p.books in x;
        
        group := group \ {p};
        
        p.books := p.books \ {t};
        
        group := group union {p};
        
        b := mk_book(t, nil);
        borrowable_books := borrowable_books union {b};
    )
    pre exists p in set group & card(p.books) > 0;

end RecordTest
